<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="../common_inertia.xacro" />

    <xacro:property name="track_width" value="0.35" />
    <xacro:property name="wheelbase" value="0.40" />
    <xacro:property name="wheel_z_offset" value="-0.05" />  

    <xacro:macro name="mecanum_wheel" params="prefix x_reflect y_reflect wheel_radius wheel_width wheel_mass pos_x pos_y pos_z">

        <link name="${prefix}_wheel_link">
            <visual >
                <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>

            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>

        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <origin xyz="${x_reflect * pos_x} ${y_reflect * pos_y} ${pos_z}" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="${prefix}_wheel_link"/>
            <axis xyz="0.0 1.0 0.0"/>
            <limit effort="50" velocity="50"/>
            <dynamics damping="0.0" friction="0.05"/>
        </joint>

        <gazebo reference="${prefix}_wheel_link">
            <mu1>2.0</mu1>
            <mu2>0.5</mu2>
            
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <fdir1>1 0 0</fdir1>
            <minDepth>0.001</minDepth>
            
            <material>Gazebo/Black</material>
        </gazebo> 

    </xacro:macro>

</robot>